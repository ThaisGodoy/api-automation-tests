        {
          "name": "Validações de cadastro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "const cenario = pm.iterationData.get(\"cenario\");",
                  "const campoErro = pm.iterationData.get(\"campoErro\");",
                  "const mensagemErro = pm.iterationData.get(\"mensagemErro\");",
                  "",
                  "pm.test(`${cenario} - Status code 400`, function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(`${cenario} - Validar mensagem de erro`, function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response[campoErro]).to.eql(mensagemErro);",
                  "});",
                  "",
                  "pm.test(`${cenario} - Resposta deve ser JSON`, function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "",
                  "const dados = pm.iterationData.toObject();",
                  "",
                  "if (dados.body) {",
                  "    pm.variables.set(",
                  "        \"requestBody\",",
                  "        JSON.stringify(dados.body)",
                  "    );",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{{requestBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://serverest.dev/usuarios",
              "protocol": "https",
              "host": [
                "serverest",
                "dev"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Email duplicado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "",
                  "const email = `qa.duplicado.${Date.now()}@example.com`;",
                  "",
                  "pm.variables.set(\"emailDuplicado\", email);",
                  "",
                  "pm.sendRequest({",
                  "    url: \"https://serverest.dev/usuarios\",",
                  "    method: \"POST\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\"",
                  "    },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            nome: \"Usuario QA Original\",",
                  "            email: email,",
                  "            password: \"Teste@123\",",
                  "            administrador: \"false\"",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (err || !res || res.code !== 201) {",
                  "        throw new Error(\"Falha ao preparar usuário original\");",
                  "    }",
                  "",
                  "    const id = res.json()._id;",
                  "    pm.variables.set(\"usuarioDuplicadoId\", id);",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "pm.test(\"CT32 - Não permitir cadastro com email duplicado\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"CT33 - Validar mensagem de email duplicado\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.message).to.eql(",
                  "        \"Este email já está sendo usado\"",
                  "    );",
                  "});",
                  "",
                  "pm.test(\"CT34 - Resposta deve ser JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "// Limpeza do usuário criado no Pre-request",
                  "const usuarioId = pm.variables.get(\"usuarioDuplicadoId\");",
                  "",
                  "if (usuarioId) {",
                  "    pm.sendRequest({",
                  "        url: `https://serverest.dev/usuarios/${usuarioId}`,",
                  "        method: \"DELETE\"",
                  "    }, function (err, res) {",
                  "        pm.test(\"CT35 - Excluir usuário de preparação\", function () {",
                  "            pm.expect(err).to.be.null;",
                  "            pm.expect(res.code).to.eql(200);",
                  "            pm.expect(res.json().message).to.eql(",
                  "                \"Registro excluído com sucesso\"",
                  "            );",
                  "        });",
                  "    });",
                  "} else {",
                  "    pm.test(\"CT35 - Usuário de preparação disponível\", function () {",
                  "        pm.expect.fail(\"ID do usuário de preparação não encontrado\");",
                  "    });",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
