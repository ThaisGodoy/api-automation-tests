        {
          "name": "Acesso com token válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "pm.test(\"JWT06 - Permitir acesso com token válido\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"JWT07 - Confirmar cadastro autorizado\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.message).to.eql(",
                  "        \"Cadastro realizado com sucesso\"",
                  "    );",
                  "",
                  "    pm.expect(response._id).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "const produtoId = pm.response.json()._id;",
                  "const token = pm.collectionVariables.get(\"authToken\");",
                  "",
                  "if (pm.response.code === 201 && produtoId && token) {",
                  "    pm.sendRequest({",
                  "        url: `https://serverest.dev/produtos/${produtoId}`,",
                  "        method: \"DELETE\",",
                  "        header: {",
                  "            Authorization: `Bearer ${token}`",
                  "        }",
                  "    }, function (err, res) {",
                  "        pm.test(\"JWT08 - Excluir produto criado no teste\", function () {",
                  "            pm.expect(err).to.be.null;",
                  "            pm.expect(res.code).to.eql(200);",
                  "            pm.expect(res.json().message).to.eql(",
                  "                \"Registro excluído com sucesso\"",
                  "            );",
                  "        });",
                  "    });",
                  "}",
                  "",
                  "const usuarioJWTId = pm.collectionVariables.get(\"usuarioJWTId\");",
                  "",
                  "if (usuarioJWTId) {",
                  "    pm.sendRequest({",
                  "        url: `https://serverest.dev/usuarios/${usuarioJWTId}`,",
                  "        method: \"DELETE\"",
                  "    }, function (err, res) {",
                  "        pm.test(\"JWT09 - Excluir usuário de autenticação\", function () {",
                  "            pm.expect(err).to.be.null;",
                  "            pm.expect(res.code).to.eql(200);",
                  "            pm.expect(res.json().message).to.eql(",
                  "                \"Registro excluído com sucesso\"",
                  "            );",
                  "        });",
                  "",
                  "        if (!err && res && res.code === 200) {",
                  "            pm.collectionVariables.unset(\"usuarioJWTId\");",
                  "            pm.collectionVariables.unset(\"emailJWT\");",
                  "            pm.collectionVariables.unset(\"authToken\");",
                  "        }",
                  "    });",
                  "} else {",
                  "    pm.test(\"JWT09 - Usuário de autenticação disponível\", function () {",
                  "        pm.expect.fail(\"ID do usuário JWT não encontrado\");",
                  "    });",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
