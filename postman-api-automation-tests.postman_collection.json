    {
      "name": "JWT",
      "item": [
        {
          "name": "Login válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "pm.test(\"JWT01 - Login realizado com sucesso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"JWT02 - Retornar token Bearer\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.authorization)",
                  "        .to.be.a(\"string\")",
                  "        .and.to.match(/^Bearer \\S+\\.\\S+\\.\\S+$/);",
                  "});",
                  "",
                  "pm.test(\"JWT03 - Armazenar token\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "   pm.collectionVariables.set(",
                  "    \"authToken\",",
                  "    response.authorization.replace(/^Bearer\\s+/i, \"\")",
                  ");",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "",
                  "const email = `qa.jwt.${Date.now()}@example.com`;",
                  "",
                  "pm.collectionVariables.set(\"emailJWT\", email);",
                  "",
                  "pm.sendRequest({",
                  "    url: \"https://serverest.dev/usuarios\",",
                  "    method: \"POST\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\"",
                  "    },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            nome: \"Usuario QA Autenticacao\",",
                  "            email: email,",
                  "            password: \"Teste@123\",",
                  "            administrador: \"true\"",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    pm.test(\"JWT00 - Preparar usuário para login\", function () {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.code).to.eql(201);",
                  "    });",
                  "",
                  "    if (!err && res && res.code === 201) {",
                  "        pm.collectionVariables.set(\"usuarioJWTId\", res.json()._id);",
                  "    }",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
